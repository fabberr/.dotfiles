# General Utilities

alias 'sauce'='source $HOME/.bashrc && echo "Reloaded profile"'

alias 'eza'='eza --color=auto --icons=auto --time-style=long-iso --header --group-directories-first --sort=name --git --git-repos-no-status --show-symlinks'

alias 'ls'='eza'
alias 'l'='eza'
alias 'll'='eza --long'
alias 'la'='eza --all'
alias 'lla'='eza --long --all'

alias 'tree'='eza --tree --ignore-glob=.git'
alias 't'='tree'
alias 'tl'='tree --long'
alias 'ta'='tree --all'
alias 'tla'='tree --long --all'

alias 'fm'='dolphin'

alias 'grep'='grep --color=auto'

alias 'mkdir'='mkdir --verbose'
alias 'rmdir'='rmdir --verbose'

# Interactive Commands

alias 'cp'='cp --interactive'
alias 'mv'='mv --interactive'
alias 'ln'='ln --interactive'
alias 'rm'='rm --interactive'

# Aliases for `clear` because I am retarded

alias 'cls'='clear'
alias 'clera'='clear'
alias 'celar'='clear'
alias 'cçear'='clear'
alias 'cler'='clear'
alias 'claer'='clear'
alias 'cealr'='clear'
alias 'clare'='clear'
alias 'lcear'='clear'
alias 'ckear'='clear'
alias 'cleart'='clear'
alias 'clesr'='clear'
alias 'clea'='clear'
alias 'clwear'='clear'
alias 'clar'='clear'
alias 'xlear'='clear'
alias 'cleat'='clear'
alias 'clrea'='clear'

# Dev tools

alias 'vi'='nvim'
alias 'vim'='nvim'
alias 'nv'='nvim'
alias 'v'='nvim'

alias 'http'='xh'
alias 'https'='xhs'

alias 'sqlite'='sqlite3'

