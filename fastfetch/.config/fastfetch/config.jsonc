{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "brightColor": true,
    "key": {
      "type": "both",
      "width": 16
    },
    "percent": {
      "type": 3, /** 1=number, 2=bar, 3=both, 9=colored number */
      "ndigits": 1,
      "spaceBeforeUnit": "never"
    },
    "bar": {
      "width": 12,
      "char": {
        "elapsed": "◼",
        "total": "─"
      }
    }
  },
  "logo": {
    "type": "auto",
    "source": "$FASTFETCH_LOGO"
  },
  "modules": [
    /* Title */
    {
      "type": "title"
    },
    {
      "type": "separator",
      "string": "─"
    },
    /* Hardware */
    {
      "type": "host",
      "format": "{name}, {vendor}"
    },
    {
      "type": "cpu",
      "format": "{name} ({cores-physical}|{cores-logical}) @ {freq-max}"
    },
    {
      "type": "memory",
      "format": ""
    },
    {
      "type": "disk",
      "format": ""
    },
    {
      "type": "battery",
      "key": "Battery",
      "format": ""
    },
    {
      "type": "separator",
      "string": "─"
    },
    /* System */
    {
      "type": "os",
      "format": ""
    },
    {
      "type": "kernel",
      "format": ""
    },
    {
      "type": "initsystem",
      "format": ""
    },
    {
      "type": "shell",
      "format": ""
    },
    {
      "type": "terminal",
      "format": ""
    },
    {
      "type": "packages",
      "format": ""
    },
    {
      "type": "separator",
      "string": "─"
    },
    /* Desktop */
    {
      "type": "lm",
      "format": ""
    },
    {
      "type": "de",
      "format": ""
    },
    {
      "type": "wm",
      "format": ""
    },
    {
      "type": "separator",
      "string": "─"
    },
    /* Devices */
    {
      "type": "keyboard",
      "format": "",
      "ignores": [
        "AT",
        "Logitech"
      ]
    },
    {
      "type": "mouse",
      "format": "",
      "ignores": [
        "PS/2",
        "DELL",
        "HP",
        "DualSense"
      ]
    },
    {
      "type": "gamepad",
      "format": "",
      "ignores": [
        "DualSense Wireless Controller Motion Sensors"
      ]
    },
    {
      "type": "display",
      "key": "Display {index}",
      "format": "{width}x{height} {inch}\", {refresh-rate} Hz ({name}) [{type}]"
    },
    {
      "type": "separator",
      "string": "─"
    },
    /* Graphics */
    {
      "type": "gpu",
      "format": "{vendor} {name} [{type}]"
    },
    {
      "type": "vulkan",
      "format": ""
    },
    {
      "type": "opengl",
      "format": ""
    }
  ]
}
