{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "brightColor": true,
    "key": {
      "type": "both",
      "width": 14
    },
    "percent": {
      "type": 3, /** 1=number, 2=bar, 3=both, 9=colored number */
      "ndigits": 1,
      "spaceBeforeUnit": "never"
    },
    "bar": {
      "width": 12,
      "char": {
        "elapsed": "◼",
        "total": "─"
      }
    }
  },
  "logo": {
    "type": "auto",
    "source": "$FASTFETCH_LOGO"
  },
  "modules": [
    {
      "type": "title"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "host",
      "format": "{name}, {vendor}"
    },
    {
      "type": "os",
      "format": ""
    },
    {
      "type": "kernel",
      "format": ""
    },
    {
      "type": "shell",
      "format": ""
    },
    {
      "type": "packages",
      "format": ""
    },
    {
      "type": "uptime",
      "format": ""
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "lm",
      "format": ""
    },
    {
      "type": "de",
      "format": ""
    },
    {
      "type": "wm",
      "format": ""
    },
    {
      "type": "terminal",
      "format": ""
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "cpu",
      "format": "{name} ({cores-physical}|{cores-logical}) @ {freq-max}"
    },
    {
      "type": "memory",
      "format": ""
    },
    {
      "type": "disk",
      "format": ""
    },
    {
      "type": "swap",
      "format": ""
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "vulkan",
      "format": ""
    },
    {
      "type": "gpu",
      "format": ""
    }
  ]
}
